"use client"

import { useState, useEffect } from "react"
import { Card, CardContent } from "@/components/ui/card"
import { Badge } from "@/components/ui/badge"
import { Button } from "@/components/ui/button"
import {
  Radio,
  Timer,
  MapPin,
  Calendar,
  Clock,
  Thermometer,
  Wind,
  Droplets,
  Gauge,
  Target,
  Zap,
  Eye,
  Bell,
  ChevronRight,
  Play,
  Pause,
  Activity,
  Sun
} from "lucide-react"
import { CountryFlag, CountryFlagMedium } from "@/components/ui/country-flag"
import { useOpenF1Data, getCircuitImageUrl, getCircuitInfo } from "@/hooks/use-openf1"
import type { Session } from "@/lib/types"
import { formatDate, formatTime } from "@/lib/utils"

interface RedesignedSessionCardProps {
  currentSession: Session | null
  testLiveMode: boolean
  onToggleTestMode: () => void
}

export function RedesignedSessionCard({
  currentSession,
  testLiveMode,
  onToggleTestMode
}: RedesignedSessionCardProps) {
  const [timeLeft, setTimeLeft] = useState({
    days: 0,
    hours: 0,
    minutes: 0,
    seconds: 0
  })

  const { circuits, weather, loading: apiLoading } = useOpenF1Data(
    currentSession ? 1 : undefined
  )

  const circuitInfo = currentSession ? getCircuitInfo(currentSession.race.circuit, circuits) : null
  const circuitImage = currentSession ? getCircuitImageUrl(currentSession.race.circuit) : ''
  const currentWeather = weather.length > 0 ? weather[weather.length - 1] : null

  useEffect(() => {
    if (!currentSession) return

    const updateCountdown = () => {
      const now = new Date().getTime()
      const sessionTime = new Date(currentSession.time).getTime()
      const difference = sessionTime - now

      if (difference > 0) {
        setTimeLeft({
          days: Math.floor(difference / (1000 * 60 * 60 * 24)),
          hours: Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)),
          minutes: Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60)),
          seconds: Math.floor((difference % (1000 * 60)) / 1000)
        })
      } else {
        setTimeLeft({ days: 0, hours: 0, minutes: 0, seconds: 0 })
      }
    }

    updateCountdown()
    const interval = setInterval(updateCountdown, 1000)
    return () => clearInterval(interval)
  }, [currentSession])

  if (!currentSession) {
    return (
      <Card className="bg-neutral-900 border-neutral-700">
        <CardContent className="p-4 text-center">
          <div className="text-neutral-400 text-sm">No upcoming sessions</div>
        </CardContent>
      </Card>
    )
  }

  const isLive = (currentSession.status === "live" || testLiveMode)
  const displayStatus = isLive ? "LIVE" : "UPCOMING"

  return (
    <Card className="bg-neutral-900 border-neutral-700 hover:border-red-500/50 transition-all duration-300 overflow-hidden h-80 relative">
      <CardContent className="p-0 h-full relative z-10">
        <div className="flex h-full">
          {/* Left Section: Flag + GP Info + Race Information */}
          <div className="flex-1 p-6 flex items-start gap-6">
            {/* Flag and Main Info */}
            <div className="flex-shrink-0">
              <div className="flex items-center gap-4 mb-4">
                <CountryFlag
                  country={currentSession.race.country}
                  width={80}
                  height={100}
                  className="shadow-lg flex-shrink-0"
                />
                <div className="h-[100px] flex flex-col justify-between py-2">
                  <div className="flex items-center gap-2">
                    <span className="text-sm text-neutral-400 font-mono">ROUND {currentSession.race.round}</span>
                    <Badge className={`px-2 py-0.5 text-xs font-bold ${
                      isLive
                        ? 'bg-red-500 text-white animate-pulse'
                        : 'bg-neutral-800 text-neutral-300 border border-neutral-600'
                    }`}>
                      {currentSession.type}
                    </Badge>
                  </div>
                  <div className="flex-1 flex flex-col justify-center">
                    <h2 className="text-xl font-bold text-white tracking-wider leading-tight">{currentSession.race.name}</h2>
                  </div>
                  <p className="text-base text-neutral-400">{currentSession.race.circuit}</p>
                </div>
              </div>

              {/* Race Information below flag */}
              <div className="w-80">
                <h3 className="text-sm font-medium text-neutral-300 tracking-wider mb-3 uppercase">Race Information</h3>
                <div className="space-y-2">
                  <div className="flex justify-between items-center p-2 bg-neutral-800/50 rounded-lg">
                    <span className="text-neutral-400">Location:</span>
                    <div className="flex items-center gap-2">
                      <CountryFlag
                        country={currentSession.race.country}
                        width={20}
                        height={15}
                        className="flex-shrink-0"
                      />
                      <span className="text-white font-medium">
                        {currentSession.race.city}, {currentSession.race.country}
                      </span>
                    </div>
                  </div>
                  <div className="flex justify-between items-center p-2 bg-neutral-800/50 rounded-lg">
                    <span className="text-neutral-400">Circuit:</span>
                    <span className="text-white font-medium">{currentSession.race.circuit}</span>
                  </div>
                  <div className="flex justify-between items-center p-2 bg-neutral-800/50 rounded-lg">
                    <span className="text-neutral-400">Session Time:</span>
                    <span className="text-white font-mono font-medium">{formatTime(currentSession.time)}</span>
                  </div>
                  {circuitInfo && (
                    <div className="flex justify-between items-center p-2 bg-neutral-800/50 rounded-lg">
                      <span className="text-neutral-400">Circuit Key:</span>
                      <span className="text-white font-mono">{circuitInfo.circuit_key}</span>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>

          {/* Right Section: Schedule/Timer */}
          <div className="w-80 p-6 border-l border-neutral-700">
            {isLive ? (
              /* LIVE MODE - Weekend Schedule */
              <div className="space-y-4">
                <h3 className="text-sm font-medium text-neutral-300 tracking-wider mb-3 uppercase">Weekend Schedule</h3>
                <div className="space-y-2">
                  {currentSession.race.sessions.practice1 && (
                    <div className="flex justify-between items-center p-3 bg-neutral-800 rounded-lg">
                      <span className="text-sm text-neutral-300 font-medium">Practice 1</span>
                      <span className="text-sm text-white font-mono font-bold">
                        {formatTime(currentSession.race.sessions.practice1)}
                      </span>
                    </div>
                  )}
                  {currentSession.race.sessions.practice2 && (
                    <div className="flex justify-between items-center p-3 bg-neutral-800 rounded-lg">
                      <span className="text-sm text-neutral-300 font-medium">Practice 2</span>
                      <span className="text-sm text-white font-mono font-bold">
                        {formatTime(currentSession.race.sessions.practice2)}
                      </span>
                    </div>
                  )}
                  {currentSession.race.sessions.practice3 && (
                    <div className="flex justify-between items-center p-3 bg-neutral-800 rounded-lg">
                      <span className="text-sm text-neutral-300 font-medium">Practice 3</span>
                      <span className="text-sm text-white font-mono font-bold">
                        {formatTime(currentSession.race.sessions.practice3)}
                      </span>
                    </div>
                  )}
                  {currentSession.race.sessions.qualifying && (
                    <div className="flex justify-between items-center p-3 bg-red-500/20 border border-red-500/30 rounded-lg">
                      <span className="text-sm text-red-400 font-medium">Qualifying</span>
                      <span className="text-sm text-red-400 font-mono font-bold">
                        {formatTime(currentSession.race.sessions.qualifying)}
                      </span>
                    </div>
                  )}
                  <div className="flex justify-between items-center p-3 bg-red-500/20 border border-red-500/30 rounded-lg">
                    <span className="text-sm text-red-400 font-bold">Race</span>
                    <span className="text-sm text-red-400 font-mono font-bold">
                      {formatTime(currentSession.race.sessions.race)}
                    </span>
                  </div>
                </div>

                {/* Live Weather Card */}
                {currentWeather && (
                  <div className="mt-4">
                    <h4 className="text-sm font-medium text-neutral-300 tracking-wider mb-2 uppercase">Live Weather</h4>
                    <div className="grid grid-cols-2 gap-2">
                      <div className="flex justify-between items-center p-2 bg-neutral-800/50 rounded-lg">
                        <span className="text-xs text-neutral-400">Air:</span>
                        <span className="text-xs text-white font-mono">{currentWeather.air_temperature}°C</span>
                      </div>
                      <div className="flex justify-between items-center p-2 bg-neutral-800/50 rounded-lg">
                        <span className="text-xs text-neutral-400">Track:</span>
                        <span className="text-xs text-white font-mono">{currentWeather.track_temperature}°C</span>
                      </div>
                      <div className="flex justify-between items-center p-2 bg-neutral-800/50 rounded-lg">
                        <span className="text-xs text-neutral-400">Humidity:</span>
                        <span className="text-xs text-white font-mono">{currentWeather.humidity}%</span>
                      </div>
                      <div className="flex justify-between items-center p-2 bg-neutral-800/50 rounded-lg">
                        <span className="text-xs text-neutral-400">Wind:</span>
                        <span className="text-xs text-white font-mono">{currentWeather.wind_speed}km/h</span>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            ) : (
              /* UPCOMING MODE - Countdown Timer */
              <div className="space-y-4">
                <h3 className="text-sm font-medium text-neutral-300 tracking-wider mb-3 uppercase">Race Countdown</h3>
                <div className="grid grid-cols-2 gap-3">
                  <div className="text-center p-3 bg-neutral-800/50 rounded-lg">
                    <div className="text-xl font-bold text-white font-mono leading-none mb-1">
                      {timeLeft.days.toString().padStart(2, '0')}
                    </div>
                    <div className="text-xs text-neutral-400 uppercase tracking-wider">Days</div>
                  </div>
                  <div className="text-center p-3 bg-neutral-800/50 rounded-lg">
                    <div className="text-xl font-bold text-white font-mono leading-none mb-1">
                      {timeLeft.hours.toString().padStart(2, '0')}
                    </div>
                    <div className="text-xs text-neutral-400 uppercase tracking-wider">Hours</div>
                  </div>
                  <div className="text-center p-3 bg-neutral-800/50 rounded-lg">
                    <div className="text-xl font-bold text-white font-mono leading-none mb-1">
                      {timeLeft.minutes.toString().padStart(2, '0')}
                    </div>
                    <div className="text-xs text-neutral-400 uppercase tracking-wider">Min</div>
                  </div>
                  <div className="text-center p-3 bg-neutral-800/50 rounded-lg">
                    <div className="text-xl font-bold text-white font-mono leading-none mb-1">
                      {timeLeft.seconds.toString().padStart(2, '0')}
                    </div>
                    <div className="text-xs text-neutral-400 uppercase tracking-wider">Sec</div>
                  </div>
                </div>

                {/* Race Preview Card */}
                <div className="mt-4">
                  <h4 className="text-sm font-medium text-neutral-300 tracking-wider mb-2 uppercase">Session Details</h4>
                  <div className="space-y-2">
                    <div className="flex justify-between items-center p-2 bg-neutral-800/50 rounded-lg">
                      <span className="text-neutral-400">Session:</span>
                      <span className="text-white font-medium">{currentSession.type}</span>
                    </div>
                    <div className="flex justify-between items-center p-2 bg-neutral-800/50 rounded-lg">
                      <span className="text-neutral-400">Duration:</span>
                      <span className="text-white font-mono">{currentSession.duration || '60'} min</span>
                    </div>
                    <div className="flex justify-between items-center p-2 bg-neutral-800/50 rounded-lg">
                      <span className="text-neutral-400">Status:</span>
                      <span className="text-green-400 font-medium">Scheduled</span>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* Action Button */}
            <div className="mt-6">
              <Button className="w-full bg-red-500 hover:bg-red-600 text-white font-semibold py-2 text-sm transition-all duration-200 hover:shadow-lg hover:shadow-red-500/25">
                {isLive ? (
                  <>
                    <Eye className="w-4 h-4 mr-2" />
                    Follow Live
                  </>
                ) : (
                  <>
                    <Bell className="w-4 h-4 mr-2" />
                    Set Reminder
                  </>
                )}
              </Button>
            </div>
          </div>
        </div>

        {/* Header - Positioned at top spanning all columns */}
        <div className="absolute top-0 left-0 right-0 p-4 pb-0 z-20">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-3">
              <div className={`p-2 rounded-lg ${
                isLive ? 'bg-red-500/20 border border-red-500/30' : 'bg-neutral-800 border border-neutral-700'
              }`}>
                {isLive ? (
                  <Radio className="w-4 h-4 text-red-400 animate-pulse" />
                ) : (
                  <Timer className="w-4 h-4 text-neutral-400" />
                )}
              </div>
              <div>
                <div className="flex items-center gap-2">
                  <h3 className="text-sm font-bold text-white tracking-wide">
                    {displayStatus} SESSION
                  </h3>
                  <Badge className={`px-2 py-0.5 text-xs font-bold ${
                    isLive
                      ? 'bg-red-500 text-white animate-pulse'
                      : 'bg-neutral-800 text-neutral-300 border border-neutral-600'
                  }`}>
                    {currentSession.type}
                  </Badge>
                </div>
                <p className="text-xs text-neutral-400">{currentSession.race.name}</p>
              </div>
            </div>

            {/* Toggle Button */}
            <Button
              onClick={onToggleTestMode}
              variant="ghost"
              size="sm"
              className="h-7 px-2 bg-neutral-800 border border-neutral-600 text-neutral-300 hover:bg-neutral-700 hover:text-white transition-colors"
            >
              {testLiveMode ? (
                <Pause className="w-3 h-3" />
              ) : (
                <Play className="w-3 h-3" />
              )}
            </Button>
          </div>
        </div>
      </CardContent>
    </Card>
  )
}
